# Copiez ce fichier en ".env.local" et remplissez avec vos propres valeurs
# (Supabase Dashboard > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon-publique

# Google AdSense (optionnel). Laissez vide tant que vous n'avez pas de
# compte AdSense approuvé — les emplacements publicitaires restent
# simplement invisibles, sans erreur.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# Notification par e-mail au vendeur à chaque commande (optionnel).
# Laissez vide pour désactiver — rien ne se passe, sans erreur.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VENDOR_NOTIFICATION_EMAIL=vous@exemple.com
